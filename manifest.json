{
  "manifest_version": 3,
  "name": "Canvas Homework Compiler",
  "version": "0.1.0",
  "description": "Scans your Canvas courses for homework/practice material in a date range and compiles the questions into one document.",
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs", "identity"],
  "optional_host_permissions": ["*://*/*"],
  "key": "",
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar"]
  }
}
